# Copy to .env and paste your own key. One key per student.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=paste-your-key-here

# Optional: override the model. The default is the cheapest current Claude model that
# still accepts a temperature. Opus 5, Sonnet 5 and Fable reject the parameter.
# ANTHROPIC_MODEL=claude-haiku-4-5
